# Zkopíruj tento soubor jako .env a doplň skutečné přihlašovací údaje.
# .env je v .gitignore a NIKDY se necommituje. Na Renderu se místo něj
# nastavují proměnné prostředí přímo ve službě.

# Connection string k Neon databázi (Settings -> Connection Details v konzoli).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Tajný klíč pro podepisování JWT tokenů - vygeneruj si vlastní příkazem:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zmen-me-na-nahodny-retezec

# --- Volitelné ---------------------------------------------------------
# Adresy, ze kterých smí chodit požadavky z prohlížeče. Prázdné stačí,
# dokud frontend servíruje ta samá aplikace (což je výchozí stav).
# CORS_ORIGINS=["http://localhost:5500"]

# Strop na velikost jedné simulace v odehraných kolech. Chrání procesor
# před požadavkem, který by běžel minuty. Na notebooku klidně víc,
# na malé instanci míň.
# MAX_SIMULATION_ROUNDS=3000000
